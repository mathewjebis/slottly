# Server Configuration
PORT=5000
JWT_SECRET=your_jwt_secret_key_here

# MongoDB Cloud Database Connection String
# Replace <db_password> with your Atlas cluster user password
MONGO_URI=mongodb+srv://<username>:<db_password>@cluster0.9gckkbo.mongodb.net/<DATABASE_NAME>?appName=Cluster0

# Nodemailer / Gmail SMTP Configuration
# Note: GMAIL_PASS must be a 16-character Google App Password without spaces
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_PASS=your_16_character_app_password
CLIENT_URL=http://localhost:5173
